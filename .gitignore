# Ignore data files
*.csv
*.xlsx
*.xls
*.json
*.jsonl
*.pdf
*.pkl
*.h5
*.parquet
*.feather
*.db
*.sqlite
*.sqlite3
*.dta
*.png
*.jpg
*.json
*.txt
*.rcv
*.htm

# Ignore temporary files
*.tmp
*.temp
*.log
*.bak
*.swp
*~
tempCodeRunnerFile.do

# Ignore build files
build/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so

# Ignore environment files
.env
.venv
env/
venv/
ENV/

# Ignore IDE files
.idea/
.vscode/
.claude/*
*.sublime-workspace
*.sublime-project

# Ignore all files in data folders
build/data/*
analysis/data/*

# Keep .gitkeep
!build/data/.gitkeep
!build/data/*/.gitkeep
!analysis/data/.gitkeep
!analysis/data/*/.gitkeep



# Keep empty directories
!*/
!.gitkeep

# Re-ignore .claude/ after the !*/ override above
.claude/

# Keep code files
!*.py
!*.do
!*.ipynb
!*.md
!*.sh
!*.bat
!*.yaml
!*.yml
!*.config

# Research data are excluded regardless of extension; retain the skeleton.
/data/**
!/data/**/
!/data/**/.gitkeep

# Local experiments; preserve the empty folder.
/trial/*
!/trial/.gitkeep

# Dependency manifests are documentation, not research data.
!requirements.txt
!requirements-*.txt

# Diagram utility output
/combined_flow*

# Keep environments excluded after legacy code-file exceptions above.
**/.venv/
